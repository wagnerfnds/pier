<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac build of the widget extension: macOS runs extensions only in the App Sandbox; the network for the boxes,
	     the App Group for the snapshot the app writes, the shared keychain for the pairings. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(PIER_BUNDLE_ID)</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PIER_BUNDLE_ID).shared</string>
	</array>
</dict>
</plist>
